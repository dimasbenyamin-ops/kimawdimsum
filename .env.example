APP_NAME="Kumaw X Atmosphr"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ---- Database ----
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kumaw_dimsum
DB_USERNAME=kumaw
DB_PASSWORD=kumawpassword
DB_ROOT_PASSWORD=rootpassword

# ---- Cache & Session ----
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ---- Redis ----
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail (Mailpit for local dev) ----
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@kumawdimsum.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Broadcasting (Reverb) ----
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=kumaw-app
REVERB_APP_KEY=kumaw-app-key
REVERB_APP_SECRET=kumaw-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---- AI / LLM ----
ANTHROPIC_API_KEY=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false
